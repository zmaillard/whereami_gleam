<div x-data="locate({ mapboxToken: '{{ mapbox_token }}' })">
<div class="hero" >
    <div class="hero-body">
            <div class="container has-text-centered">
                <h1 class="title">Where Am I?</h1>
                <h2 class="subtitle">Information about where you are, or where you want to be</h2>
                <div x-show="hasplace">
                    <div x-html="formatplace"></div>
                    <div>or search for a custom location in the United States</div>
                </div>
                <div class="box">
                    <div class="field is-grouped">
                        <p class="control is-expanded">
                            <input x-model="searchFilter" class="input" type="text" placeholder="Where Is This Place?">
                        </p>
                        <p class="control">
                            <button @click="search" role="button" class="button is-info" type="submit">Find Place</button>
                        </p>
                    </div>
                </div>
                <div x-show="hasplace">
                    <button @click="locate" :class="loadingResults && 'is-loading'" class="button is-primary"  x-text="detailsButtonText"></button>
                    <input name="lat" type="hidden" id="latitude" name="latitude" x-model="latitude" />
                    <input name="lng" type="hidden" id="longitude" name="longitude" x-model="longitude"  />
                </div>
            </div>
    </div>

    <div x-show="showSearch">
    </div>
    <section x-show="lengthOfDay" x-transition class="section results-section">
        <h1 class="title" x-text="titleText"></h1>
        <div class="content is-size-4">
            <p class="icon-text"><span class="icon"><i class="ei-b ei-clock-8" role="img" aria-label="time"></i></span>Local time is <strong x-text="currentTime"></strong> observing the <strong x-text="timezone"></strong> time zone.  <strong x-text="timezone"></strong> <strong x-text="dstStatement"></strong>.</p>
            <p class="icon-text"><span class="icon"><i class="ei-b ei-sunrise" role="img" aria-label="sunrise"></i></span>Sunrise today is at <strong x-text="sunrise"></strong>.  <span class="icon"><i class="ei-b ei-sunset" role="img" aria-label="sunset"></i></span>Sunset is at <strong x-text="sunset"></strong>.  Today, the length of the day is <strong x-text="lengthOfDay"></strong> long.</p>
            <p x-show="firstForecastDetails"><span class="icon" x-show="firstForecastIcon"><i class="ei-b" :class="firstForecastIcon" role="img" aria-label="sunrise"></i></span><strong x-text="firstForecast"></strong> <span x-text="firstForecastDetails"></span></p>
        </div>
    </section>
    <section x-show="countyStateFormatted" x-transition class="section">
        <div class="fixed-grid">
            <div class="grid">
                <div class="cell">
                    <div class="content is-size-4" x-show="countyStateFormatted">
                        <p>Located in <strong x-text="countyStateFormatted"></strong> <span x-show="elevation">at an elevation of <strong x-text="elevation"></strong>.</span></p>
                        <p class="icon-text" x-show="nearestSummit">The nearest highest location is <span class="icon"><i class="ei-b ei-mountain-snow" role="img" aria-label="mountain"></i></span><strong x-text="nearestSummit"></strong> at an elevation of <strong x-text="nearestSummitElevation"></strong> (<span x-text="nearestSummitDistance"></span>)</p>
                        <p class="icon-text" x-show="nearestNationalPark">The nearest National Park is <span class="icon"><i class="ei-b ei-pine-tree" role="img" aria-label="park"></i></span><strong x-text="nearestNationalPark"></strong> (<span x-text="nearestNationalParkDistance"></span>)</p>
                        <p class="icon-text" x-show="drainage"><span class="icon"><i class="ei-b ei-droplet" role="img" aria-label="park"></i></span>Water here flows into the <strong x-text="drainage"></strong>.</p>
                        <p x-show="level3Ecoregion">It is part of the <strong x-text="level3Ecoregion"></strong> ecoregion.</p>
                    </div>
                </div>
                <div class="cell">
                    <div class="map" id="countyMap"></div>
                </div>
            </div>
        </div>
    </section>
    <section x-show="hydrographyFormatted" x-transition class="section">
        <div class="content is-size-4">The waterways that water flows through to the <strong x-text="drainage"></strong> are: <span x-text="hydrographyFormatted"></span> </div>
        <div class="content is-size-4">The level 2 ecoregion is <strong x-text="level2Ecoregion"></strong>.  The level 1 ecoregion is <strong x-text="level1Ecoregion"></strong>.</div>
        <a href="https://www.epa.gov/eco-research/ecoregions-north-america">Ecoregions of North America (US EPA)</a>
    </section>
</div>
