<div x-data="locate({ mapboxToken: '{{ mapbox_token }}' })">
<div class="hero" >
    <div class="hero-body">
            <div class="container has-text-centered">
                <h1 class="title">Where Am I?</h1>
                <h2 class="subtitle">Information about where you are, or where you want to be</h2>
                <div x-show="hasplace">
                    <div x-html="formatplace"></div>
                    <div>or search for a custom location in the United States</div>
                </div>
                <div class="box">
                    <div class="field is-grouped">
                        <p class="control is-expanded">
                            <input x-model="searchFilter" class="input" type="text" placeholder="Where Is This Place?">
                        </p>
                        <p class="control">
                            <button @click="search" role="button" class="button is-info" type="submit">Find Place</button>
                        </p>
                    </div>
                </div>
                <div x-show="hasplace">
                    <!--<form id="locationForm" method="POST" action="/" >-->
                    <!--<button class="button is-primary" data-loading-class="is-loading" data-loading-disable hx-post="/details" hx-target="#details"  hx-swap="show:#details:top" x-text="detailsButtonText"></button>-->
                    <button @click="locate" class="button is-primary"  x-text="detailsButtonText"></button>

                    <input name="lat" type="hidden" id="latitude" name="latitude" x-model="latitude" />
                    <input name="lng" type="hidden" id="longitude" name="longitude" x-model="longitude"  />
                </div>
            </div>
    </div>

    <div x-show="showSearch">
    </div>
    <section x-show="hasPlace" class="section">
        <div class="content is-size-4"><strong x-text="results.place"></strong> is located in <strong x-text="countyStateFormatted"></strong>.
            It is located in the <strong x-text="timezone"></strong> time zone.
            Water here flows into the <strong x-text="drainage">Pacific Ocean</strong>.  It is part of the <strong x-text="level3Ecoregion">Snake River Plain</strong> ecoregion.</div>
        <div class="content is-size-4">Sunrise today is at <strong x-text="sunrise"></strong>.  Sunset is at <strong x-text="sunset"></strong>.  Today is <strong x-text="lengthOfDay"></strong> long.
    </section>
<section x-show="hasPlace" class="section">
  <h1 class="title">Place Details</h1>
    <div class="content">
        <table>
           <tbody>
               <tr>
                   <th>Coordinates</th>
                   <td>46.1891, -123.8327</td>
                   <th>Time Zone</th>
                   <td>America/Los_Angeles (Local Time: 2026-10-20 17:21:52)</td>
               </tr>
               <tr>
                   <th>Sunrise</th>
                   <td>7:41AM -0700</td>
                   <th>Sunset</th>
                   <td>6:18PM -0700</td>
               </tr>
           </tbody>
        </table>
    </div>
</section>
<section class="section">
  <h1 class="title">Forecast</h1>
  <h2 class="subtitle">Weather</h2>
</section>
</div>
